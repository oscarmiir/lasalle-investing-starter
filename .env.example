# Copia este fichero como .env (Git lo ignora) y rellena los valores de tu cuenta. No subas nunca .env.
# Cloudflare R2: R2 > Manage API tokens > Create API token (Object Read & Write, solo este bucket).
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=lasalle-ra1-lake
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
